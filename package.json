{
  "name": "ixia-ui-react",
  "version": "1.1.0",
  "description": "A React component library for building polished product interfaces with composable primitives and Tailwind CSS styling.",
  "keywords": [
    "accessible-ui",
    "component-library",
    "components",
    "design-system",
    "react",
    "storybook",
    "tailwindcss",
    "typescript",
    "ui"
  ],
  "homepage": "https://github.com/PHNTMbandit/ixia-ui-react#readme",
  "bugs": {
    "url": "https://github.com/PHNTMbandit/ixia-ui-react/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PHNTMbandit/ixia-ui-react.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./styles": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && vp build && pnpm run build:css",
    "build-storybook": "pnpm build:tailwind && storybook build",
    "build:css": "node -e \"const fs=require('fs');fs.copyFileSync('src/styles/input.css','dist/styles.css')\"",
    "build:tailwind": "pnpm dlx @tailwindcss/cli -i ./src/styles/input.css -o ./dist/styles.css",
    "check": "vp check",
    "chromatic": "pnpm dlx chromatic --project-token chpt_96e26fa06b6e511",
    "commit": "git add . && git commit",
    "commit:skip": "git add . && git commit --no-verify",
    "cz": "cz",
    "dev": "vp pack --watch",
    "pack": "vp pack && pnpm run build:css",
    "prepare": "vp config --no-agent",
    "preview": "vp preview",
    "storybook": "concurrently 'pnpm:watch:*'",
    "test": "vp test",
    "watch:storybook": "storybook dev -p 6006",
    "watch:tailwind": "pnpm dlx @tailwindcss/cli -i ./src/styles/input.css -o ./src/styles/output.css --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@daypicker/react": "^10.0.2",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.11",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "oxc-transform-react": "^0.153.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@faker-js/faker": "^10.6.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/node": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.1.2",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chromatic": "^18.7.2",
    "commitizen": "^4.3.2",
    "concurrently": "^10.0.5",
    "cz-conventional-changelog": "^3.3.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "oxlint-tailwindcss": "^1.10.2",
    "playwright": "^1.63.0",
    "semantic-release": "^25.0.9",
    "shiki": "^4.4.3",
    "storybook": "^10.6.0",
    "typescript": "~7.0.2",
    "uuid": "^14.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
